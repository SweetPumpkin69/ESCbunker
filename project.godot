config_version=5

[application]

config/name="BREACH | Bunker Entry"
config/description="Editable CSG bunker entry beneath a forest sinkhole."
run/main_scene="res://scenes/entry_room_puzzle.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[display]

